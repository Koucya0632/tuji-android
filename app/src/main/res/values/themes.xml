<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The Android-side ground, used before Compose has drawn anything — which
      on a cold start is a whole second, so it is not a formality. It carries
      the launch mark itself (see @drawable/launch_background), the same way
      iOS's UILaunchScreen names an image and not only a colour. Everything
      after Compose's first frame comes from TujiTheme.

      Deliberately does NOT set statusBarColor / navigationBarColor /
      windowLightNavigationBar. `enableEdgeToEdge()` owns the system bars at
      runtime, so those attributes would be a second place claiming the same
      decision. Lint found the duplication when minSdk was 26 and one of them
      was API 27; raising minSdk to 29 silenced the check, not the reason.
    -->
    <style name="Theme.Tuji" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
