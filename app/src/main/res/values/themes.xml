<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The Android-side ground, used before Compose has drawn anything. It exists
      so the window does not flash the platform's default white behind 紙
      (#FBF7EF) on cold start — the same reason iOS pins its launch screen
      colour. Everything after the first frame comes from TujiTheme.

      Deliberately does NOT set statusBarColor / navigationBarColor /
      windowLightNavigationBar. `enableEdgeToEdge()` owns the system bars at
      runtime, so those attributes would be a second place claiming the same
      decision. Lint found the duplication when minSdk was 26 and one of them
      was API 27; raising minSdk to 29 silenced the check, not the reason.
    -->
    <style name="Theme.Tuji" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/tuji_paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
