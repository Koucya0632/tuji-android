<?xml version="1.0" encoding="utf-8"?>
<!--
  The mascot, generated from the iOS AppIcon (tuji-icon-light.png) so the
  launcher matches the Play store listing icon. The 1024px art fills the 72dp
  safe zone; the 18dp margin is its edge pixels extended outward. No
  <monochrome> layer: there's no single-colour cut of the mascot yet, and themed
  icons fall back to this full-colour one without it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/tuji_brand_secondary" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
