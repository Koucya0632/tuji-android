<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The offline banner and the reload when the network comes back. A
         library already merges this in; declared here so the feature does not
         depend on which libraries happen to be linked. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 自製圖鑑 拍照. Requested at the moment the user opens the camera, not
         at launch: a permission asked for before the feature is visible is a
         permission most people decline. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- `required="false"` so a device with no camera can still install and
         use everything else. 自製圖鑑 is one feature, not the app. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- 每日學習提醒. Asked for when the reminder is switched on in 設定, not at
         launch. Boot is only so a reboot does not silently drop the week of
         reminders already laid out. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 跟讀 and 語音輸入 in 助手. Asked for the first time the mic is tapped,
         not at launch. Audio goes to the device's speech recogniser and is not
         recorded or kept by the app. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Package visibility: without this, SpeechRecognizer cannot see the
         recognition service on Android 11+ and reports none available. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".TujiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Tuji">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Tuji"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Where Apple sign-in comes back to.

              Apple has no native Android sign-in, so the flow leaves for a
              Custom Tab and returns through this filter; MainActivity hands the
              Intent to Supabase's handleDeeplinks. `singleTask` above is what
              routes a warm return to onNewIntent instead of a second Activity.

              The scheme is fixed rather than derived from applicationId, which
              carries a `.debug` suffix — a redirect URL that differs per build
              type is a second entry somebody has to remember to register in the
              Supabase dashboard. Both must be listed there under
              Authentication → URL Configuration → Redirect URLs.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.tuji.android" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.ReminderRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
