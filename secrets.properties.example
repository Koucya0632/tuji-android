# secrets.properties.example — Tuji Android
#
# Copy to secrets.properties (gitignored) and fill in. Mirrors
# tuji-ios/Config/Secrets.xcconfig; the values are the same ones.
#
#   cp secrets.properties.example secrets.properties
#
# CI reads these from environment variables of the same name instead —
# see app/build.gradle.kts `secret()`, which falls through to System.getenv.

# Backend (tuji-web on Vercel). Both iOS Debug and Release point here today.
TUJI_BASE_URL=https://everyday-english-picture-dictionary.vercel.app

# Supabase. Dashboard -> Project Settings -> API.
#
# ⚠️ The project's "dev" and "prod" refs are THE SAME PROJECT. A debug build on
# an emulator writes to real users' data, and anything you break online will
# look like an app bug. There is no staging tier to hide behind.
#
# ⚠️ anon key only. The service_role key must never reach a client — RLS is
# what stands between one account's rows and another's.
TUJI_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
TUJI_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google sign-in. This is the WEB client ID (Credential Manager wants the web
# one, not the Android one), and it must also be listed in the Supabase Google
# provider's allowed client IDs. A separate ANDROID OAuth client bound to the
# signing SHA-1 still has to exist in GCP — it just is not named here.
TUJI_GOOGLE_WEB_CLIENT_ID=1234567890-xxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
